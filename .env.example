OPENROUTER_API_KEY=replace-with-your-key
OPENROUTER_MODEL=openai/gpt-4o-mini
DONNA_AGENT_API_KEY=
DONNA_LOG_LEVEL=info

# Optional settings
# OPENROUTER_APP_URL=https://example.com
# DONNA_SYSTEM_PROMPT_FILE=./system_prompt.txt
# DONNA_PROFILE_SEARCH_URL=https://provider.example/search
# DONNA_PROFILE_SEARCH_API_KEY=replace-with-search-provider-key
# DONNA_MIN_CONFIDENCE=0.55
# Google Workspace OAuth (enables Gmail/Calendar integration)
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/v1/integrations/google/callback
# DONNA_DATABASE_URL=postgresql://donna:password@127.0.0.1:5432/donna
# DONNA_JWT_SECRET=replace-with-at-least-32-random-characters
# DONNA_ADDR=127.0.0.1:8080
# DONNA_SYSTEM_PROMPT_FILE=./system_prompt.txt
